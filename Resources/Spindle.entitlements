<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Spindle is not sandboxed: a sandboxed app cannot own a desktop-level
	     window, and Apple Events to Music/Spotify would need a temporary
	     exception. It talks to no network except artwork URLs Spotify hands it. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
